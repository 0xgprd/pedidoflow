# =============================================================================
# Pedidoflow - Variables de entorno (template)
# Copiar a .env y rellenar con valores reales. NUNCA comitear .env.
# =============================================================================

# --- App ---
APP_ENV=development                  # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-string

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql+psycopg://pedidoflow:pedidoflow@localhost:5432/pedidoflow
DATABASE_ECHO=false

# --- Redis (cola Celery) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth (Clerk) ---
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWT_ISSUER=https://xxx.clerk.accounts.dev

# --- IA (Anthropic Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Embeddings (Voyage AI) ---
VOYAGE_API_KEY=pa-xxx
VOYAGE_MODEL=voyage-3

# --- Storage PDFs (Cloudflare R2 / S3) ---
S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
S3_BUCKET=pedidoflow-documents
S3_REGION=auto

# --- Microsoft Graph (Outlook) ---
MS_GRAPH_TENANT_ID=xxx
MS_GRAPH_CLIENT_ID=xxx
MS_GRAPH_CLIENT_SECRET=xxx
MS_GRAPH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/outlook/callback

# --- Sage 200 Sales API (por cliente; estos valores son default tenant) ---
SAGE200_BASE_URL=https://sage200.sage.es/api/sales
SAGE200_API_VERSION=1.0
SAGE200_OAUTH_CLIENT_ID=xxx
SAGE200_OAUTH_CLIENT_SECRET=xxx
SAGE200_OAUTH_TOKEN_URL=https://login.microsoftonline.com/.../oauth2/v2.0/token
SAGE200_SUBSCRIPTION_KEY=xxx
SAGE200_X_SITE=xxx

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- Observability ---
SENTRY_DSN=
LOGFIRE_TOKEN=
